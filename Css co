*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial;
}

body{
background:#f5f5f5;
color:#333;
}

/* NAV */

header{
background:#3e2723;
color:white;
}

nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px;
}

nav ul{
display:flex;
list-style:none;
gap:20px;
}

nav a{
color:white;
text-decoration:none;
}

/* HERO */

body section:nth-of-type(1){
height:400px;
background:url("img/cafe1.jpg") center/cover;
color:white;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
}

button{
padding:10px 20px;
background:#6d4c41;
color:white;
border:none;
margin-top:10px;
}

/* CARDS */

body section:nth-of-type(2){
padding:60px;
text-align:center;
background:white;
}

body section:nth-of-type(2) div{
display:flex;
justify-content:center;
gap:20px;
margin-top:20px;
}

article{
background:#eee;
padding:20px;
width:200px;
border-radius:10px;
}

/* MISSION */

body section:nth-of-type(3){
padding:60px;
text-align:center;
background:#d7ccc8;
}

/* TESTIMONIOS */

body section:nth-of-type(4){
padding:60px;
text-align:center;
background:white;
}

body section:nth-of-type(4) div{
display:flex;
gap:20px;
justify-content:center;
margin-top:20px;
}

/* BIO */

body section:nth-of-type(5){
padding:60px;
text-align:center;
background:#efebe9;
}

/* CONTACTO */

body section:nth-of-type(6){
padding:60px;
text-align:center;
background:white;
}

/* CAROUSEL */

section:nth-of-type(6) div{
width:300px;
margin:auto;
overflow:hidden;
position:relative;
}

section:nth-of-type(6) div div{
display:flex;
width:300%;
transition:0.5s;
}

img{
width:300px;
height:200px;
object-fit:cover;
}

input{
display:none;
}

#img1:checked ~ div{
transform:translateX(0);
}

#img2:checked ~ div{
transform:translateX(-300px);
}

#img3:checked ~ div{
transform:translateX(-600px);
}

label{
display:inline-block;
width:12px;
height:12px;
background:#6d4c41;
border-radius:50%;
margin:5px;
cursor:pointer;
}

/* FOOTER */

footer{
background:#3e2723;
color:white;
text-align:center;
padding:20px;
}

/* RESPONSIVE */

@media (max-width:768px){

nav{
flex-direction:column;
gap:10px;
}

body section:nth-of-type(2) div,
body section:nth-of-type(4) div{
flex-direction:column;
align-items:center;
}

}
